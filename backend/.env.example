# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL via Prisma)
# Replace user, password, host, port, and database name with your local PostgreSQL credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medicore_db?schema=public"

# CORS Configuration
CLIENT_URL="http://localhost:5173"

# JWT Secret (Owned by Member 1 for Auth)
JWT_SECRET="medicore_jwt_secret_development_key_change_in_production"
JWT_EXPIRES_IN="7d"

