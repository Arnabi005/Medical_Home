# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/medicore_db

# Legacy/Preserved PostgreSQL Connection (Optional/Preserved)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medicore_db?schema=public"

# CORS Configuration
CLIENT_URL="http://localhost:5173"

# JWT Secret
JWT_SECRET="medicore_jwt_secret_development_key_change_in_production"
JWT_EXPIRES_IN="7d"
